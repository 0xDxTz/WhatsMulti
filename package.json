{
    "name": "@dutakey/whatsmulti",
    "version": "2.0.0-rc.0",
    "description": "Multi-session WhatsApp orchestration for Node.js, built on Baileys",
    "author": "DutaKey",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./qr": {
            "types": "./dist/qr/index.d.ts",
            "default": "./dist/qr/index.js"
        },
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "gen": "node scripts/generate.mjs",
        "gen:check": "node scripts/generate.mjs --check",
        "vectors": "node scripts/generate-vectors.mjs",
        "verify:pack": "npm run build && publint && attw --pack . --profile esm-only",
        "check": "npm run gen:check && npm run lint && npm run typecheck && npm run test"
    },
    "peerDependencies": {
        "@whiskeysockets/baileys": ">=7.0.0-rc14 <8",
        "drizzle-orm": ">=0.36",
        "hono": ">=4",
        "ioredis": ">=5",
        "mongodb": ">=6",
        "pino": ">=9",
        "qrcode": ">=1.5"
    },
    "peerDependenciesMeta": {
        "drizzle-orm": {
            "optional": true
        },
        "hono": {
            "optional": true
        },
        "ioredis": {
            "optional": true
        },
        "mongodb": {
            "optional": true
        },
        "pino": {
            "optional": true
        },
        "qrcode": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.2",
        "@eslint/js": "^9.39.2",
        "@types/node": "^24.10.1",
        "@types/qrcode": "^1.5.6",
        "@vitest/coverage-v8": "^3.2.4",
        "@whiskeysockets/baileys": "7.0.0-rc14",
        "eslint": "^9.39.2",
        "globals": "^16.5.0",
        "prettier": "^3.6.2",
        "publint": "^0.3.16",
        "qrcode": "^1.5.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vitest": "^3.2.4",
        "yaml": "^2.8.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/0xDxTz/WhatsMulti.git"
    },
    "keywords": [
        "whatsapp",
        "baileys",
        "multi-session",
        "whatsapp-api"
    ],
    "bugs": {
        "url": "https://github.com/0xDxTz/WhatsMulti/issues"
    },
    "homepage": "https://github.com/0xDxTz/WhatsMulti#readme"
}
